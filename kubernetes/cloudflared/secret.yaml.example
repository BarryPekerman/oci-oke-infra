# Copy this to secret.yaml and fill in your tunnel credentials
# DO NOT commit secret.yaml to git!
#
# Get credentials: cloudflared tunnel create <tunnel-name>
# This creates ~/.cloudflared/<TUNNEL_ID>.json
#
# Base64 encode the JSON: base64 -w0 < ~/.cloudflared/<TUNNEL_ID>.json
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-credentials
  namespace: cloudflared
type: Opaque
data:
  credentials.json: BASE64_ENCODED_CREDENTIALS_JSON

