# Allow-list: ignore everything, then unignore exactly what may be committed.
# Adding a file? Add its !path line here too ("nothing to commit" = missing line).
*

# Unignore directories (needed to traverse into them)
!.github/
!.github/workflows/
!kubernetes/
!kubernetes/argocd/
!kubernetes/storage/
!scripts/
!terraform/
!terraform/environments/
!terraform/environments/dev/
!terraform/modules/
!terraform/modules/backups/
!terraform/modules/bastion/
!terraform/modules/budget/
!terraform/modules/ci-upgrader/
!terraform/modules/networking/
!terraform/modules/oke/

# Unignore specific files
!.github/workflows/terraform-check.yml
!.gitignore
!README.md
!kubernetes/argocd/values.yaml
!kubernetes/storage/storageclass.yaml
!scripts/check-free-tier.sh
!scripts/deploy.sh
!scripts/kube-tunnel.sh
!scripts/setup-kubeconfig.sh
!terraform/.terraform.lock.hcl
!terraform/environments/dev/terraform.tfvars.example
!terraform/cloudflare.tf
!terraform/grafana.tf
!terraform/main.tf
!terraform/modules/backups/main.tf
!terraform/modules/backups/outputs.tf
!terraform/modules/backups/variables.tf
!terraform/modules/backups/versions.tf
!terraform/modules/bastion/main.tf
!terraform/modules/bastion/outputs.tf
!terraform/modules/bastion/variables.tf
!terraform/modules/bastion/versions.tf
!terraform/modules/budget/main.tf
!terraform/modules/budget/outputs.tf
!terraform/modules/budget/variables.tf
!terraform/modules/budget/versions.tf
!terraform/modules/ci-upgrader/main.tf
!terraform/modules/ci-upgrader/outputs.tf
!terraform/modules/ci-upgrader/variables.tf
!terraform/modules/ci-upgrader/versions.tf
!terraform/modules/networking/main.tf
!terraform/modules/networking/outputs.tf
!terraform/modules/networking/variables.tf
!terraform/modules/networking/versions.tf
!terraform/modules/oke/main.tf
!terraform/modules/oke/outputs.tf
